// ============================================
// Prisma Schema — DML - Duta Mitra Luhur Platform
// Hybrid B2B + B2C E-Commerce
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  CUSTOMER
  BUSINESS
  ADMIN
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocType {
  NPWP
  SIUP
  NIB
}

enum DocStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProductType {
  RETAIL
  INDUSTRIAL
  BOTH
}

enum OrderType {
  B2C
  B2B
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
}

enum QuoteStatus {
  PENDING
  REVIEWED
  QUOTED
  ACCEPTED
  REJECTED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  GATEWAY
  BANK_TRANSFER
  TERM
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// ============================================
// USER & AKUN BISNIS
// ============================================

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  phone          String?
  role           Role            @default(CUSTOMER)
  companyName    String?
  npwp           String?
  businessStatus BusinessStatus?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  addresses         Address[]
  businessDocuments BusinessDocument[]
  cart              Cart?
  orders            Order[]
  quotes            Quote[]
  reviews           Review[]

  @@map("users")
}

model Address {
  id            String  @id @default(cuid())
  userId        String
  label         String
  recipientName String
  phone         String
  fullAddress   String
  city          String
  province      String
  postalCode    String
  isDefault     Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model BusinessDocument {
  id         String    @id @default(cuid())
  userId     String
  docType    DocType
  fileUrl    String
  status     DocStatus @default(PENDING)
  uploadedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("business_documents")
}

// ============================================
// KATALOG PRODUK
// ============================================

model Category {
  id       String  @id @default(cuid())
  parentId String?
  name     String
  slug     String  @unique
  iconUrl  String?

  parent   Category?  @relation("CategoryToSub", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSub")
  products Product[]

  @@map("categories")
}

model Product {
  id             String      @id @default(cuid())
  categoryId     String
  name           String
  slug           String      @unique
  sku            String      @unique
  description    String?
  productType    ProductType @default(RETAIL)
  price          Decimal?    @db.Decimal(12, 2) // null jika industrial custom price
  unit           String // pcs, meter, kg, roll, lembar
  stock          Int         @default(0)
  minOrderQty    Int         @default(1)
  specifications Json? // { ketebalan, material, ukuran, hardness }
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  quoteItems QuoteItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([productType])
  @@map("products")
}

model ProductImage {
  id           String @id @default(cuid())
  productId    String
  url          String
  displayOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ============================================
// KERANJANG (ALUR B2C)
// ============================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  qty       Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ============================================
// PESANAN (ALUR B2C)
// ============================================

model Order {
  id            String             @id @default(cuid())
  userId        String
  addressId     String
  orderNumber   String             @unique
  type          OrderType          @default(B2C)
  status        OrderStatus        @default(PENDING)
  totalAmount   Decimal            @db.Decimal(12, 2)
  paymentStatus OrderPaymentStatus @default(UNPAID)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  address Address     @relation(fields: [addressId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  qty          Int
  priceAtOrder Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ============================================
// RFQ / PENAWARAN (ALUR B2B)
// ============================================

model Quote {
  id            String      @id @default(cuid())
  userId        String
  quoteNumber   String      @unique
  status        QuoteStatus @default(PENDING)
  customerNotes String?
  adminNotes    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  items   QuoteItem[]
  invoice Invoice?

  @@index([userId])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id           String   @id @default(cuid())
  quoteId      String
  productId    String
  qtyRequested Int
  notes        String?
  quotedPrice  Decimal? @db.Decimal(12, 2) // diisi admin saat review

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@map("quote_items")
}

model Invoice {
  id              String        @id @default(cuid())
  quoteId         String        @unique
  invoiceNumber   String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  dueDate         DateTime
  status          InvoiceStatus @default(UNPAID)
  paymentProofUrl String?
  createdAt       DateTime      @default(now())

  quote   Quote    @relation(fields: [quoteId], references: [id])
  payment Payment?

  @@map("invoices")
}

// ============================================
// PEMBAYARAN (DIPAKAI ORDER MAUPUN INVOICE)
// ============================================

model Payment {
  id         String        @id @default(cuid())
  orderId    String?       @unique
  invoiceId  String?       @unique
  method     PaymentMethod
  amount     Decimal       @db.Decimal(12, 2)
  status     PaymentStatus @default(PENDING)
  gatewayRef String?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  order   Order?   @relation(fields: [orderId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

// ============================================
// ULASAN PRODUK
// ============================================

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@map("reviews")
}
