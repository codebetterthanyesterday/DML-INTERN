// ============================================
// Prisma Schema — DML - Duta Mitra Luhur Platform
// Hybrid B2B + B2C E-Commerce
// ============================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum Role {
  CUSTOMER
  BUSINESS
  ADMIN
  SUPER_ADMIN
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocType {
  NPWP
  SIUP
  NIB
}

enum DocStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProductType {
  RETAIL
  INDUSTRIAL
  BOTH
}

enum OrderType {
  B2C
  B2B
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
}

enum QuoteStatus {
  PENDING
  REVIEWED
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
  ADMIN_REJECTED // Penawaran sudah melewati batas waktu berlaku
  WAITING_SUPERADMIN_APPROVAL // Harga sudah diisi admin, menunggu approval Super Admin
  SUPERADMIN_REVISION // Super Admin meminta admin merevisi harga
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  GATEWAY
  BANK_TRANSFER
  TERM
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationType {
  NEW_ORDER
  NEW_QUOTE
  PAYMENT_RECEIVED
  SYSTEM_ALERT
  BUSINESS_VERIFICATION
  LOW_STOCK_ALERT
  STOCK_OPNAME_VARIANCE
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  OPNAME
}

enum StockReason {
  PURCHASE // masuk: pembelian/restock dari supplier
  RETURN_IN // masuk: retur dari pelanggan
  SALE // keluar: terjual (order/manual)
  DAMAGED // keluar: rusak/kadaluarsa
  ADJUSTMENT // koreksi manual (masuk/keluar)
  OPNAME_CORRECTION // koreksi hasil stock opname
}

enum AuditAction {
  USER_APPROVED
  USER_REJECTED
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_DELETED
  ROLE_CHANGED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  QUOTE_APPROVED_SUPERADMIN // Super Admin menyetujui quotation nilai besar
  QUOTE_REJECTED_SUPERADMIN // Super Admin menolak/meminta revisi quotation
}

enum QuoteLogAction {
  CREATED
  OFFER_SUBMITTED
  SUPERADMIN_REVISION_REQUESTED
  SUPERADMIN_APPROVED
  CUSTOMER_REJECTED
  CUSTOMER_ACCEPTED
  EXPIRED
  ADMIN_REJECTED
}

enum ComplaintType {
  CANCELLATION
  RETURN
  REFUND
  REPLACEMENT
}

enum ComplaintStatus {
  PENDING
  REVIEWING
  REVIEWED
  APPROVED
  APPROVED_FOR_RETURN
  REJECTED
  RESOLVED
}

enum ReturnStatus {
  PENDING_SHIPMENT
  SHIPPED
  DELIVERED
  CONFIRMED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// USER & AKUN BISNIS
// ============================================

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  phone          String?
  role           Role            @default(CUSTOMER)
  companyName    String?
  npwp           String?
  businessStatus BusinessStatus?
  isSuspended    Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  addresses         Address[]
  businessDocuments BusinessDocument[]
  cart              Cart?
  orders            Order[]
  quotes            Quote[]

  notifications     Notification[]
  auditLogs         AuditLog[]
  stockLogs         StockLog[]
  complaints        Complaint[]
  complaintMessages ComplaintMessage[]
  reviews           Review[]

  @@map("users")
}

model Address {
  id            String  @id @default(cuid())
  userId        String
  label         String
  recipientName String
  phone         String
  fullAddress   String
  city          String
  province      String
  postalCode    String
  provinceId    String?
  cityId        String?
  district      String?
  districtId    String?
  isDefault     Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model BusinessDocument {
  id         String    @id @default(cuid())
  userId     String
  docType    DocType
  fileUrl    String
  status     DocStatus @default(PENDING)
  uploadedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("business_documents")
}

// ============================================
// KATALOG PRODUK
// ============================================

model Category {
  id       String  @id @default(cuid())
  parentId String?
  name     String
  slug     String  @unique
  iconUrl  String?

  parent   Category?  @relation("CategoryToSub", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSub")
  products Product[]

  @@map("categories")
}

model Product {
  id                String      @id @default(cuid())
  categoryId        String
  name              String
  slug              String      @unique
  sku               String      @unique
  description       String?
  productType       ProductType @default(RETAIL)
  price             Decimal?    @db.Decimal(12, 2) // null jika industrial custom price
  unit              String // pcs, meter, kg, roll, lembar
  stock             Int         @default(0)
  lowStockThreshold Int         @default(5)
  minOrderQty       Int         @default(1)
  weight            Int         @default(1000) // in grams
  specifications    Json? // { ketebalan, material, ukuran, hardness }
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  tiers          ProductTier[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  quoteItems     QuoteItem[]

  stockLogs      StockLog[]
  complaintItems ComplaintItem[]
  reviews        Review[]

  @@index([categoryId])
  @@index([productType])
  @@map("products")
}

model ProductImage {
  id           String @id @default(cuid())
  productId    String
  url          String
  displayOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductTier {
  id           String  @id @default(cuid())
  productId    String
  minQty       Int
  maxQty       Int? // null means unlimited
  pricePerUnit Decimal @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_tiers")
}

// ============================================
// KERANJANG (ALUR B2C)
// ============================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  qty       Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ============================================
// PESANAN (ALUR B2C)
// ============================================

model Order {
  id               String             @id @default(cuid())
  userId           String
  addressId        String
  orderNumber      String             @unique
  type             OrderType          @default(B2C)
  status           OrderStatus        @default(PENDING)
  totalAmount      Decimal            @db.Decimal(12, 2)
  shippingFee      Decimal            @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal            @default(0) @db.Decimal(12, 2)
  voucherCode      String?
  courier          String?
  shippingService  String?
  trackingNumber   String?
  deliveryNoteUrl  String?
  deliveryNoteName String?
  shippedAt        DateTime?
  paymentStatus    OrderPaymentStatus @default(UNPAID)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  address    Address     @relation(fields: [addressId], references: [id])
  items      OrderItem[]
  payment    Payment?
  voucher    Voucher?    @relation(fields: [voucherCode], references: [code])
  complaints Complaint[]
  reviews    Review[]

  @@index([userId])
  @@index([status])
  @@index([voucherCode])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  qty          Int
  priceAtOrder Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ============================================
// RFQ / PENAWARAN (ALUR B2B)
// ============================================

model Quote {
  id                   String      @id @default(cuid())
  userId               String
  quoteNumber          String      @unique
  status               QuoteStatus @default(PENDING)
  customerNotes        String?
  adminNotes           String?
  superAdminNotes      String? // Catatan dari Super Admin (approval/revisi)
  superAdminId         String? // ID Super Admin yang mereview
  superAdminReviewedAt DateTime? // Waktu Super Admin melakukan review
  totalQuotedValue     Decimal?    @db.Decimal(14, 2) // Cache total nilai penawaran
  expiresAt            DateTime? // Batas waktu berlakunya penawaran (diset Admin)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  items   QuoteItem[]
  logs    QuoteLog[]
  invoice Invoice?

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("quotes")
}

model QuoteItem {
  id           String   @id @default(cuid())
  quoteId      String
  productId    String
  qtyRequested Int
  notes        String?
  quotedPrice  Decimal? @db.Decimal(12, 2) // diisi admin saat review

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@map("quote_items")
}

model QuoteLog {
  id         String         @id @default(cuid())
  quoteId    String
  action     QuoteLogAction
  actorId    String?
  actorName  String?
  actorRole  Role?
  notes      String?        @db.Text
  totalValue Decimal?       @db.Decimal(14, 2)
  createdAt  DateTime       @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_logs")
}

model Invoice {
  id              String        @id @default(cuid())
  quoteId         String        @unique
  invoiceNumber   String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  dueDate         DateTime
  status          InvoiceStatus @default(UNPAID)
  paymentProofUrl String?
  createdAt       DateTime      @default(now())

  quote   Quote    @relation(fields: [quoteId], references: [id])
  payment Payment?

  @@map("invoices")
}

// ============================================
// PEMBAYARAN (DIPAKAI ORDER MAUPUN INVOICE)
// ============================================

model Payment {
  id         String        @id @default(cuid())
  orderId    String?       @unique
  invoiceId  String?       @unique
  method     PaymentMethod
  amount     Decimal       @db.Decimal(12, 2)
  status     PaymentStatus @default(PENDING)
  gatewayRef String?
  paymentUrl String?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  order   Order?   @relation(fields: [orderId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}


// ============================================
// NOTIFIKASI (SISTEM)
// ============================================

model Notification {
  id        String           @id @default(cuid())
  userId    String? // Nullable jika notifikasi broadcast (misal untuk semua ADMIN)
  type      NotificationType
  title     String
  message   String
  linkUrl   String? // URL tujuan ketika di klik (misal: /admin/orders/[id])
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id        String      @id @default(cuid())
  adminId   String
  targetId  String // ID of the user or document being modified
  action    AuditAction
  details   String? // Optional JSON or string for old/new values, reasons, etc.
  createdAt DateTime    @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetId])
  @@map("audit_logs")
}

// ============================================
// STOCK LOG (Pencatatan & Log Aktivitas Stok)
// ============================================

model StockLog {
  id             String            @id @default(cuid())
  productId      String
  adminId        String?
  type           StockMovementType
  reason         StockReason
  quantityChange Int // signed: + untuk stock in, - untuk stock out, +/- untuk opname
  stockBefore    Int
  stockAfter     Int
  note           String?
  referenceId    String? // opsional: orderId, opname session id, dll
  createdAt      DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  admin   User?   @relation(fields: [adminId], references: [id])

  @@index([productId, createdAt])
  @@index([type])
  @@index([createdAt])
  @@map("stock_logs")
}

// ============================================
// CMS / SITE SETTINGS
// ============================================

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ============================================
// VOUCHER / PROMO
// ============================================

model Voucher {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2) // persentase (e.g. 10 untuk 10%) atau nominal
  minPurchase   Decimal      @default(0) @db.Decimal(12, 2)
  maxDiscount   Decimal?     @db.Decimal(12, 2) // berguna jika tipe PERCENTAGE
  validFrom     DateTime?
  validUntil    DateTime?
  usageLimit    Int? // Kuota maksimal dipakai oleh seluruh customer
  usageCount    Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders Order[]

  @@index([code])
  @@map("vouchers")
}

// ============================================
// COMPLAINTS (PEMBATALAN, RETUR, REFUND)
// ============================================

model Complaint {
  id          String          @id @default(cuid())
  orderId     String
  userId      String
  type        ComplaintType
  status      ComplaintStatus @default(PENDING)
  reason      String
  description String?         @db.Text
  proofUrl    String?
  adminNotes  String?         @db.Text
  requiresReturn            Boolean  @default(true)
  replacementCourier        String?
  replacementTrackingNumber String?
  replacementShippedAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order Order           @relation(fields: [orderId], references: [id])
  user  User            @relation(fields: [userId], references: [id])
  items ComplaintItem[]
  messages ComplaintMessage[]
  return   Return?

  @@index([orderId])
  @@index([userId])
  @@map("complaints")
}

model ComplaintMessage {
  id          String    @id @default(cuid())
  complaintId String
  senderId    String    // User ID of the sender (Admin or Customer)
  senderRole  Role      // Role of the sender at the time of message
  message     String    @db.Text
  attachmentUrl String? // Opsional lampiran gambar/dokumen
  createdAt   DateTime  @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_messages")
}

model Return {
  id              String       @id @default(cuid())
  complaintId     String       @unique
  status          ReturnStatus @default(PENDING_SHIPMENT)
  courier         String?
  trackingNumber  String?
  shippingReceipt String?      // Bukti resi pengiriman retur
  shippedAt       DateTime?
  receivedAt      DateTime?    // Kapan gudang DML menerima retur
  adminNotes      String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("returns")
}

model ComplaintItem {
  id          String @id @default(cuid())
  complaintId String
  productId   String
  qty         Int

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("complaint_items")
}

// ============================================
// REVIEW (ULASAN)
// ============================================

model Review {
  id        String       @id @default(cuid())
  userId    String
  productId String
  orderId   String?
  rating    Int
  comment   String?      @db.Text
  mediaUrls String[]     @default([])
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@map("reviews")
}
